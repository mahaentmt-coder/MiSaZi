# ─────────────────────────────────────────
# MiSaZi Art Gallery — Environment Variables
# Copy this file to .env.local and fill in all values.
# NEVER commit .env.local to version control.
# ─────────────────────────────────────────

# ── Sanity CMS ──────────────────────────
# Get these from https://sanity.io/manage → your project → API
NEXT_PUBLIC_SANITY_PROJECT_ID=your_project_id_here
NEXT_PUBLIC_SANITY_DATASET=production

# ── Resend (email) ──────────────────────
# Get your key from https://resend.com/api-keys
# Also verify your domain at https://resend.com/domains
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Site URL ────────────────────────────
NEXT_PUBLIC_SITE_URL=https://misaziart.com
